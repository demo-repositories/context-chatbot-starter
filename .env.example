# ──────────────────────────────────────────────────────────────────────────────
# 1. LLM provider  (select one: "anthropic" or "openai")
# ──────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic

# Supply the key for the provider that you selected above.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: use a different model for the selected provider.
# The default models are: anthropic -> claude-opus-5, openai -> gpt-5
# AI_MODEL=claude-opus-5

# ──────────────────────────────────────────────────────────────────────────────
# 2. Sanity Context MCP  ← this is the connection to your knowledge base
# ──────────────────────────────────────────────────────────────────────────────
# Copy this URL from the top of your "Agent Context" document in Sanity Studio.
# Format:
#   https://api.sanity.io/<apiVersion>/agent-context/<projectId>/<dataset>/<slug>
# To show all of the dataset, remove the /<slug> at the end. This removes the filter.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-03-06/agent-context/your-project-id/production/your-agent-context-slug

# Use a read-only token. Get it from sanity.io/manage → Project → API → Tokens.
# The Viewer role is sufficient.
SANITY_API_READ_TOKEN=sk...
